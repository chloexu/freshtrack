{
  "expo": {
    "name": "FreshTrack",
    "slug": "freshtrack",
    "scheme": "freshtrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FreshTrack to access your camera to take photos of groceries."
        }
      ]
    ]
  }
}
